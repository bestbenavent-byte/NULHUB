rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data, userId) {
      return data.id == userId
        && data.id == request.auth.uid
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 50
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() <= 120;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
